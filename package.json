{
  "name": "tripwire-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Mutation testing for Kane CLI browser suites: break the app on purpose, see whether the tests notice.",
  "type": "module",
  "workspaces": [
    "packages/cli",
    "demo/shop"
  ],
  "scripts": {
    "shop": "npm --workspace demo/shop start",
    "proxy": "node packages/cli/bin/tripwire.js proxy --target http://localhost:3000 --port 8080",
    "demo": "node packages/cli/bin/tripwire.js demo",
    "test": "node --test \"packages/cli/test/*.test.js\"",
    "report:publish": "node site/publish.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
